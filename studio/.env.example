# Copy to .env (Studio reads SANITY_STUDIO_* variables). These are not secrets.
SANITY_STUDIO_PROJECT_ID=
SANITY_STUDIO_DATASET=production
# Next.js site that renders draft previews. Use the production URL once deployed.
SANITY_STUDIO_PREVIEW_URL=http://localhost:3000
# Studio hostname → https://<host>.sanity.studio (must be globally unique)
SANITY_STUDIO_HOST=makedit
