# Copy to .env.local for local development. Never commit real values.

# ── Site ──────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://makedit.co.kr

# ── Sanity (public: safe to expose to the browser) ─────
# Create at https://www.sanity.io/manage → project ID
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-10-01
# Hosted Studio URL (after `npm run deploy` in /studio), e.g. https://makedit.sanity.studio
NEXT_PUBLIC_SANITY_STUDIO_URL=

# ── Sanity (server only: NEVER prefix with NEXT_PUBLIC_) ─
# API token with "Viewer" permission. Used only for draft preview.
SANITY_API_READ_TOKEN=
# Random string shared with the Sanity webhook (GROQ-powered webhook → /api/revalidate)
SANITY_REVALIDATE_SECRET=

# ── Contact form delivery (server only) ────────────────
# Resend (https://resend.com). Until these are set, the form honestly reports
# that online submission is unavailable instead of faking success.
RESEND_API_KEY=
# Inbox that receives inquiries
CONTACT_TO_EMAIL=
# Verified sender on your domain, e.g. "Makedit <noreply@makedit.co.kr>"
CONTACT_FROM_EMAIL=
